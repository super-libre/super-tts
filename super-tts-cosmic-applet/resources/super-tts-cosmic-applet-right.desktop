[Desktop Entry]
Name=Super TTS Applet (Right Side)
Comment=Text-to-speech panel applet - Right side visualization display
Type=Application
Exec=super-tts-cosmic-applet --side right
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Iced;Speech;TTS;Super;
Icon=super-tts-cosmic-applet
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=50
